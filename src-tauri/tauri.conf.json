{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Balance Toolkit",
  "version": "0.1.0",
  "identifier": "com.the-balance-toolkit",
  "build": {
    "beforeDevCommand": "src-tauri/scripts/tauri_before_dev.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "The Balance Toolkit",
        "width": 1400,
        "height": 920,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
