  {
    "id": "session_lsl_toggle",
    "name": "Enable LSL Output",
    "equation": "",
    "tooltip": "Toggle to stream data over LabStreamingLayer (LSL).\nStream name and source ID are configured in Settings.",
    "description": []
  },
  {
    "id": "session_tcp_toggle",
    "name": "Enable TCP Output",
    "equation": "",
    "tooltip": "Toggle to send data over a TCP connection.\nHost and port are configured in Settings.",
    "description": []
  },
  {
    "id": "session_window_size",
    "name": "Window Size",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>T</mi><mi>window</mi></msub><mo>=</mo><mfrac><mi>window_size_ms</mi><mn>1000</mn></mfrac></mrow></math>",
    "tooltip": "Duration of data used per computation window. Larger windows smooth metrics; smaller windows react faster.",
    "description": ["Units: milliseconds (ms)."]
  },
  {
    "id": "session_window_slide",
    "name": "Window Slide (Hop)",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>T</mi><mi>hop</mi></msub><mo>=</mo><mfrac><mi>window_slide_ms</mi><mn>1000</mn></mfrac></mrow></math>",
    "tooltip": "Time step between consecutive windows. Smaller hops update graphs more often with more overlap.",
    "description": ["Units: milliseconds (ms)."]
  },
  {
    "id": "session_sampling_rate",
    "name": "Sampling Rate",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>f</mi><mi>s</mi></msub><mo>=</mo><mi>sampling_rate</mi><mo>;</mo><mi>dt</mi><mo>=</mo><mfrac><mn>1</mn><msub><mi>f</mi><mi>s</mi></msub></mfrac></mrow></math>",
    "tooltip": "Uniform resampling rate used after interpolation. Higher f_s captures faster sway but increases compute.",
    "description": ["Units: Hertz (Hz); dt in seconds (s)."]
  },
  {
    "id": "session_interpolation",
    "name": "Interpolation Method",
    "equation": "",
    "tooltip": "How irregular COP samples are resampled to uniform time. Affects spectra and velocity estimates.",
    "description": ["Linear (fast)", "Cubic (smooth)", "Polynomial/Lagrange (local, higher-order)."]
  },
  {
    "id": "session_save_location",
    "name": "Save Location",
    "equation": "",
    "tooltip": "Folder where session outputs are stored.",
    "description": []
  },
  {
    "id": "session_cop_x",
    "name": "Center of Pressure (X)",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>COP</mi><mi>x</mi></msub><mo>=</mo><mfrac><mrow><mfenced><mrow><mi>TR</mi><mo>+</mo><mi>BR</mi></mrow></mfenced><mo>−</mo><mfenced><mrow><mi>TL</mi><mo>+</mo><mi>BL</mi></mrow></mfenced></mrow><mrow><mi>TR</mi><mo>+</mo><mi>BR</mi><mo>+</mo><mi>TL</mi><mo>+</mo><mi>BL</mi></mrow></mfrac></mrow></math>",
    "tooltip": "Lateral COP position (unitless ratio, ~−1 left to +1 right).",
    "description": ["TR: Top right force", "BR: Bottom right force", "TL: Top left force", "BL: Bottom left force"]
  },
  {
    "id": "session_cop_y",
    "name": "Center of Pressure (Y)",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>COP</mi><mi>y</mi></msub><mo>=</mo><mfrac><mrow><mfenced><mrow><mi>TR</mi><mo>+</mo><mi>TL</mi></mrow></mfenced><mo>−</mo><mfenced><mrow><mi>BR</mi><mo>+</mo><mi>BL</mi></mrow></mfenced></mrow><mrow><mi>TR</mi><mo>+</mo><mi>BR</mi><mo>+</mo><mi>TL</mi><mo>+</mo><mi>BL</mi></mrow></mfrac></mrow></math>",
    "tooltip": "Anterior–posterior COP position (unitless ratio, ~−1 back to +1 front).",
    "description": ["TR: Top right force", "BR: Bottom right force", "TL: Top left force", "BL: Bottom left force"]
  },
  {
    "id": "session_cop_z",
    "name": "Total Force",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>COP</mi><mi>z</mi></msub><mo>=</mo><mi>TR</mi><mo>+</mo><mi>BR</mi><mo>+</mo><mi>TL</mi><mo>+</mo><mi>BL</mi></mrow></math>",
    "tooltip": "Total load on the board (Newtons).",
    "description": []
  },
  {
    "id": "session_stability_index",
    "name": "Stability Index",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>SI</mi><mo>=</mo><msqrt><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo>⋅</mo><msub><mo>∑</mo><mi>i</mi></msub><mo>[</mo><mrow><msup><mrow><mo>(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>−</mo><mover accent=\"true\"><mi>x</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>−</mo><mover accent=\"true\"><mi>y</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></msqrt></mrow></math>",
    "tooltip": "RMS distance of COP from its mean (unitless).",
    "description": ["N: number of samples", "x̄: mean COP X", "ȳ: mean COP Y."]
  },
  {
    "id": "session_mean_velocity_x",
    "name": "Mean Velocity (X)",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>v</mi><mrow><mi>cop</mi><mo>,</mo><mi>x</mi></mrow></msub><mo>=</mo><mi>mean</mi><mo>(</mo><mfrac><mrow><mo>|</mo><mo>Δ</mo><msub><mi>x</mi><mi>i</mi></msub><mo>|</mo></mrow><mrow><mo>Δ</mo><msub><mi>t</mi><mi>i</mi></msub></mrow></mfrac><mo>)</mo></mrow></math>",
    "tooltip": "Average absolute COP velocity along X (units: ratio/s).",
    "description": ["Δx_i: COP X change", "Δt_i: time step (s)."]
  },
  {
    "id": "session_mean_velocity_y",
    "name": "Mean Velocity (Y)",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>v</mi><mrow><mi>cop</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>=</mo><mi>mean</mi><mo>(</mo><mfrac><mrow><mo>|</mo><mo>Δ</mo><msub><mi>y</mi><mi>i</mi></msub><mo>|</mo></mrow><mrow><mo>Δ</mo><msub><mi>t</mi><mi>i</mi></msub></mrow></mfrac><mo>)</mo></mrow></math>",
    "tooltip": "Average absolute COP velocity along Y (units: ratio/s).",
    "description": ["Δy_i: COP Y change", "Δt_i: time step (s)."]
  },
  {
    "id": "session_mean_velocity",
    "name": "Mean Velocity",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>mean_velocity</mi><mo>=</mo><mi>mean</mi><mo>(</mo><mfrac><mrow><msqrt><mrow><msup><mrow><mo>Δ</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>Δ</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mn>2</mn></msup></mrow></msqrt></mrow><mrow><mo>Δ</mo><msub><mi>t</mi><mi>i</mi></msub></mrow></mfrac><mo>)</mo></mrow></math>",
    "tooltip": "Average resultant COP speed (units: ratio/s).",
    "description": ["Δx_i, Δy_i: COP changes", "Δt_i: time step (s)."]
  },
  {
    "id": "session_total_path_length",
    "name": "Total Path Length",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>L</mi><mo>=</mo><msub><mo>∑</mo><mi>i</mi></msub><msqrt><mrow><msup><mrow><mo>Δ</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>Δ</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mn>2</mn></msup></mrow></msqrt></mrow></math>",
    "tooltip": "Total distance traveled by COP (unitless path length in ratio units).",
    "description": []
  },
  {
    "id": "session_velocity_moment",
    "name": "Velocity Moment",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>velocity_moment</mi><mo>=</mo><mfrac><mi>total_path_length</mi><mi>total_time</mi></mfrac></mrow></math>",
    "tooltip": "Average speed of COP over time (units: ratio/s).",
    "description": []
  },
  {
    "id": "session_mlsi",
    "name": "Medio-Lateral Stability Index",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>MLSI</mi><mo>=</mo><msqrt><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo>⋅</mo><msub><mo>∑</mo><mi>i</mi></msub><msup><msub><mi>x</mi><mi>i</mi></msub><mn>2</mn></msup></mrow></msqrt></mrow></math>",
    "tooltip": "RMS COP excursion along X (unitless ratio).",
    "description": []
  },
  {
    "id": "session_apsi",
    "name": "Anterior–Posterior Stability Index",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>APSI</mi><mo>=</mo><msqrt><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo>⋅</mo><msub><mo>∑</mo><mi>i</mi></msub><msup><msub><mi>y</mi><mi>i</mi></msub><mn>2</mn></msup></mrow></msqrt></mrow></math>",
    "tooltip": "RMS COP excursion along Y (unitless ratio).",
    "description": []
  },
  {
    "id": "session_vsi",
    "name": "Vertical Stability Index",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>VSI</mi><mo>=</mo><msqrt><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo>⋅</mo><msub><mo>∑</mo><mi>i</mi></msub><msup><mrow><mo>(</mo><mi>baseline</mi><mo>−</mo><msub><mi>z</mi><mi>i</mi></msub><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mrow></math>",
    "tooltip": "RMS deviation of force from baseline load (Newtons).",
    "description": ["zᵢ: total force", "baseline: User weight (Kg)"]
  },
  {
    "id": "session_dpsi",
    "name": "Dynamic Postural Stability Index",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>DPSI</mi><mo>=</mo><msqrt><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo>⋅</mo><msub><mo>∑</mo><mi>i</mi></msub><mo>[</mo><mrow><msup><msub><mi>x</mi><mi>i</mi></msub><mn>2</mn></msup><mo>+</mo><msup><msub><mi>y</mi><mi>i</mi></msub><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>(</mo><mi>baseline</mi><mo>−</mo><msub><mi>z</mi><mi>i</mi></msub><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></msqrt></mrow></math>",
    "tooltip": "Combined RMS of medio-lateral, anterior–posterior, and vertical components.",
    "description": ["Mixed units: ratio + Newtons."]
  },
  {
    "id": "session_confidence_ellipse",
    "name": "Confidence Ellipse (95%)",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>=</mo><msqrt><mrow><msubsup><mi>χ</mi><mn>2</mn><mn>2</mn></msubsup><mo>(</mo><mn>0.95</mn><mo>)</mo><mo>·</mo><msub><mi>λ</mi><mn>1</mn></msub></mrow></msqrt><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>=</mo><msqrt><mrow><msubsup><mi>χ</mi><mn>2</mn><mn>2</mn></msubsup><mo>(</mo><mn>0.95</mn><mo>)</mo><mo>·</mo><msub><mi>λ</mi><mn>2</mn></msub></mrow></msqrt></mrow></math>",
    "tooltip": "Ellipse enclosing ~95% of COP points (unitless).",
    "description": ["r1, r2: semi-axes", "θ: rotation angle (rad)."]
  },
  {
    "id": "session_convex_hull",
    "name": "Convex Hull",
    "equation": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>CH</mi><mo>=</mo><mi>conv</mi><mo>(</mo><mo>{</mo><mo>(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo>)</mo><mo>}</mo><mo>)</mo></mrow></math>",
    "tooltip": "Polygon enclosing all {(x_i, y_i)} with minimal convex boundary",
    "description": []
  },
